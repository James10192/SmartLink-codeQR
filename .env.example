# Database
DATABASE_URL="postgresql://user:password@localhost:5432/smartlink"

# Better-Auth
BETTER_AUTH_SECRET="your-secret-key-here-change-in-production" # Generate with: bunx better-auth secret
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Facebook OAuth (Optional)
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Apple OAuth (Optional)
APPLE_CLIENT_ID="your-apple-service-id"
APPLE_CLIENT_SECRET="your-apple-client-secret"

# Resend (Email Sending)
RESEND_API_KEY="your-resend-api-key"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-api-key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# CinetPay (Paiements Mobile Money)
CINETPAY_API_KEY="your-cinetpay-api-key"
CINETPAY_SITE_ID="your-cinetpay-site-id"
CINETPAY_SECRET_KEY="your-cinetpay-secret-key"

# Lemon Squeezy (Paiements Cartes Bancaires)
LEMON_SQUEEZY_API_KEY="your-lemon-squeezy-api-key"
LEMON_SQUEEZY_STORE_ID="your-lemon-squeezy-store-id"
LEMON_SQUEEZY_PRO_MONTHLY_VARIANT_ID="your-pro-monthly-variant-id"
LEMON_SQUEEZY_PRO_YEARLY_VARIANT_ID="your-pro-yearly-variant-id"
LEMON_SQUEEZY_PACK_STARTER_VARIANT_ID="your-pack-starter-variant-id"
LEMON_SQUEEZY_WEBHOOK_SECRET="your-lemon-squeezy-webhook-secret"

# Vercel Cron Security
CRON_SECRET="your-random-secret-here" # Generate with: openssl rand -base64 32

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
